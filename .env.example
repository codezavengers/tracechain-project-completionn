# TRACECHAIN environment variables.
#
# Copy this file to .env.local and fill in only the values you have.
# EVERY blockchain/price variable below is now genuinely OPTIONAL — Bitcoin,
# Ethereum, Polygon, Arbitrum, Optimism, Base, Avalanche, Solana, TRON and USD
# price enrichment are all LIVE out of the box via free, keyless public
# endpoints (Blockstream, Blockscout, Routescan, public RPC nodes, TronGrid,
# CoinGecko). The ONE genuine exception is BSC transaction history, which has
# no free public indexer today (verified) and needs ETHERSCAN_API_KEY.
# With nothing set at all, only BSC falls back to clearly-labelled DEMO DATA;
# every other chain investigates real, live blockchain data. Never commit a
# filled-in .env.local.

# ---------------------------------------------------------------------------
# EVM chains — Ethereum, Polygon, BSC, Arbitrum, Optimism, Base, Avalanche
# ---------------------------------------------------------------------------
# Ethereum, Polygon, Arbitrum, Optimism, Base and Avalanche are LIVE by
# default with NO configuration: balance/tx lookups use public RPC nodes and
# transaction history uses free Etherscan-compatible indexers (Blockscout /
# Routescan). BSC is the one chain that genuinely requires a key here — no
# free public indexer for BSC transaction history exists as of this writing.
#
# Setting a single Etherscan V2 unified-API key upgrades ALL of the above to
# the higher-throughput/more-reliable Etherscan API (optional everywhere
# except BSC, where it's required). Get a free key at https://etherscan.io/apis.
ETHERSCAN_API_KEY=

# Optional per-chain overrides if you use a dedicated explorer endpoint/key
# instead of the unified Etherscan V2 API (or the free default) for a
# specific chain. Any chain left blank uses ETHERSCAN_API_KEY if set, else
# its free public fallback (BSC has none, so it needs one of these two).
TRACECHAIN_ETH_API_URL=
TRACECHAIN_ETH_API_KEY=
TRACECHAIN_POLYGON_API_URL=
TRACECHAIN_POLYGON_API_KEY=
TRACECHAIN_BSC_API_URL=
TRACECHAIN_BSC_API_KEY=
TRACECHAIN_ARBITRUM_API_URL=
TRACECHAIN_ARBITRUM_API_KEY=
TRACECHAIN_OPTIMISM_API_URL=
TRACECHAIN_OPTIMISM_API_KEY=
TRACECHAIN_BASE_API_URL=
TRACECHAIN_BASE_API_KEY=
TRACECHAIN_AVALANCHE_API_URL=
TRACECHAIN_AVALANCHE_API_KEY=

# ---------------------------------------------------------------------------
# Bitcoin
# ---------------------------------------------------------------------------
# Bitcoin is LIVE by default — Blockstream's public Esplora API
# (https://blockstream.info/api) requires no key. Override only if you run
# your own Esplora-compatible endpoint (e.g. a self-hosted mempool.space).
TRACECHAIN_BTC_API_URL=
TRACECHAIN_BTC_API_KEY=

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# Solana is LIVE by default — the public mainnet-beta JSON-RPC
# (https://api.mainnet-beta.solana.com) requires no key. It is strictly
# rate-limited, so override with a dedicated RPC endpoint for higher-volume
# investigation traffic.
TRACECHAIN_SOLANA_RPC_URL=
TRACECHAIN_SOLANA_RPC_KEY=

# ---------------------------------------------------------------------------
# TRON
# ---------------------------------------------------------------------------
# TronGrid (https://www.trongrid.io) is a public, keyless indexer — TRON is
# LIVE by default with no configuration. Its keyless rate limit is modest;
# set TRACECHAIN_TRON_API_KEY (a free TronGrid API key) for a higher limit
# under heavier investigation traffic. Never required to go live.
TRACECHAIN_TRON_API_URL=
TRACECHAIN_TRON_API_KEY=

# ---------------------------------------------------------------------------
# Historical / spot USD price enrichment (optional, all chains)
# ---------------------------------------------------------------------------
# USD price enrichment is LIVE by default via CoinGecko's free public API
# (https://api.coingecko.com/api/v3) — no key required. Set
# TRACECHAIN_PRICE_API_URL only to point at a different/self-hosted
# CoinGecko-compatible endpoint, and TRACECHAIN_PRICE_API_KEY for a CoinGecko
# Pro/Demo key (higher rate limit). If a price lookup ever genuinely fails,
# usdValue/usdBalance are null (never a fabricated 0) and tracing still
# succeeds — price enrichment never blocks a trace.
TRACECHAIN_PRICE_API_URL=
TRACECHAIN_PRICE_API_KEY=

# ---------------------------------------------------------------------------
# Persistent investigation storage (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL selects the persistence backend. It is the ONLY switch:
#
#   DATABASE_URL configured
#     -> PostgreSQL persistent storage (ProductionDatabase)
#     -> investigations, transactions, reports and all related records
#        survive browser refresh, navigation and server restart
#     -> if PostgreSQL is unreachable, requests return a clear error and NEVER
#        silently fall back to in-memory storage
#
#   DATABASE_URL not configured
#     -> DevelopmentDatabase (IN_MEMORY)
#     -> data lives only for the server process and DOES NOT survive a restart
#     -> surfaced in the UI/API as persistenceMode = "IN_MEMORY"
#
# Initialize / migrate the schema (idempotent) once DATABASE_URL is set:
#
#   pnpm db:init
#
# Never commit a real database URL. Example shape only (do NOT use as-is):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing secret for session JWTs. Falls back to an insecure demo secret if
# unset — set a strong random value (e.g. `openssl rand -base64 32`) before
# any non-local deployment.
TRACECHAIN_JWT_SECRET=
